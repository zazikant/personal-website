# DoqueRAG — Environment Variables
#
# Copy this file to `.env` for local development, or set these in
# Vercel → Project → Settings → Environment Variables.
#
# ONLY SMTP_PASS IS REQUIRED — all other values have working defaults.
# The password must NEVER be committed to the repository.

# ─── REQUIRED ───────────────────────────────────────────────────────────
# Password for the SMTP sending account (news@gemengserv.net)
SMTP_PASS=your-smtp-password-here

# ─── OPTIONAL (defaults shown) ──────────────────────────────────────────
# SMTP server hostname
# For cPanel/hosting: mail.gemengserv.net
# For Google Workspace: smtp.gmail.com
# For Office 365: smtp.office365.com
SMTP_HOST=mail.gemengserv.net

# SMTP port (465 for SSL, 587 for TLS)
SMTP_PORT=465

# SMTP username (the sending email address)
SMTP_USER=news@gemengserv.net

# Recipient address (where contact form submissions are sent)
MAIL_TO=shashikant.zarekar@gemengserv.com
