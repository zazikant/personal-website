{
  "rewrites": [
    { "source": "/api/contact", "destination": "/api/contact.js" },
    { "source": "/__clerk/(.*)", "destination": "/api/clerk-proxy/[...path]?path=/$1" }
  ],
  "functions": {
    "api/contact.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/clerk-proxy/[...path].js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
